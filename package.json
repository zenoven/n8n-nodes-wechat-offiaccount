{
	"name": "n8n-nodes-wechat-offiaccount",
	"version": "0.3.6-zenoven.1",
	"description": "wechat offiaccount node",
	"keywords": [
		"n8n-community-node-package",
		"wehcat",
		"wehcat-offiaccount"
	],
	"license": "MIT",
	"homepage": "https://github.com/zenoven/n8n-nodes-wechat-offiaccount#readme",
	"author": {
		"name": "blowsnow",
		"email": "im.blowsnow@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zenoven/n8n-nodes-wechat-offiaccount.git"
	},
	"bugs": {
		"url": "https://github.com/zenoven/n8n-nodes-wechat-offiaccount/issues"
	},
	"engines": {
		"node": "18 || 20 || >=22",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@9.1.4",
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"test": "pnpm build && node --test test/*.test.js",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/WechatOfficialAccountCredentialsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WechatOfficialAccountNode/WechatOfficialAccountNode.node.js",
			"dist/nodes/WechatOfficialAccountTrigger/WechatOfficialAccountTrigger.node.js",
			"dist/nodes/WechatOfficialAccountResponseNode/WechatOfficialAccountResponseNode.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^22.13.1",
		"@typescript-eslint/parser": "^7.15.0",
		"eslint": "^8.56.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.1",
		"express": "^4.21.2",
		"gulp": "^4.0.2",
		"prettier": "^3.3.2",
		"require-glob": "^4.1.0",
		"typescript": "^5.5.3"
	},
	"peerDependencies": {
		"n8n-workflow": "latest"
	},
	"dependencies": {
		"form-data": "^4.0.6",
		"glob": "^13.0.6",
		"xml-js": "^1.6.11"
	}
}
